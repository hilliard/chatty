---
import '../styles/chat.css';
const { title = 'Chatty — Good people. Great conversations.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#14141f" /><title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=chatty-1" />
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('chatty-theme')||'dark'}catch{}</script>
</head><body><slot /></body></html>
