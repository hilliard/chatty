          "200": {
            "description": "200: text/event-stream. Room messages, presence, userlist, typing, private mentions, and global room updates.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/stream": {
      "get": {
        "tags": [
          "Live"
        ],
        "summary": "Subscribe to community updates",
        "description": "200: text/event-stream. Global presence counts, newroom, renamed, private mentions, notificationsread. Does not join a room.",
        "security": [
          {
            "chatSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "200: text/event-stream. Global presence counts, newroom, renamed, private mentions, notificationsread. Does not join a room.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "List your unread mentions",
        "description": "200: { notifications, count }. Up to 50 latest unread mentions and total unread count.",
        "security": [
          {
            "chatSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "200: { notifications, count }. Up to 50 latest unread mentions and total unread count."
